@page "/register"
@using System.Security.Cryptography
@using System.Text
@using Web_Drones_Proyect.Models
@using Web_Drones_Proyect.Data.Repositories
@using MudBlazor

<MudPaper Class="pa-6 mx-auto" Style="max-width:400px; margin-top:50px;">
    <MudText Typo="Typo.h5" Class="mb-4">Crear Cuenta</MudText>

    <MudForm @ref="_form">
        <MudTextField Label="Nombre"
                      TValue="string"
                      Value="_user.UserName"
                      ValueChanged="@((string v) => _user.UserName = v)"
                      ValueExpression="@(() => _user.UserName)"
                      Required="true" />

        <MudTextField Label="Correo Electrónico"
                      TValue="string"
                      Value="_user.Email"
                      ValueChanged="@((string v) => _user.Email = v)"
                      ValueExpression="@(() => _user.Email)"
                      Required="true" />

        <MudTextField Label="Contraseña"
                      TValue="string"
                      InputType="InputType.Password"
                      Value="_password"
                      ValueChanged="@((string v) => _password = v)"
                      ValueExpression="@(() => _password)"
                      Required="true" />

        <MudTextField Label="Confirmar Contraseña"
                      TValue="string"
                      InputType="InputType.Password"
                      Value="_confirmPassword"
                      ValueChanged="@((string v) => _confirmPassword = v)"
                      ValueExpression="@(() => _confirmPassword)"
                      Required="true" />

        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   Class="mt-4"
                   OnClick="RegisterAsync">
            Registrarse
        </MudButton>
    </MudForm>

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <MudText Color="Color.Error" Class="mt-2">@_errorMessage</MudText>
    }
</MudPaper>

@code {
    private MudForm _form = default!;
    private UserEntity _user = new();
    private string _password = string.Empty;
    private string _confirmPassword = string.Empty;
    private string? _errorMessage;

    [Inject] private IRepository<User> UserRepository { get; set; } = default!;
    [Inject] private NavigationManager Navigation { get; set; } = default!;

    private async Task RegisterAsync()
    {
        if (_form != null)
            await _form.Validate();

        _errorMessage = string.Empty;

        if (!_form.IsValid)
            return;

        if (_password != _confirmPassword)
        {
            _errorMessage = "Las contraseñas no coinciden.";
            return;
        }

        // Verificar si el correo ya existe
        var existingUser = (await UserRepository.FindAsync(u => u.Email == _user.Email)).FirstOrDefault();
        if (existingUser != null)
        {
            _errorMessage = "Este correo ya está registrado.";
            return;
        }

        var userToSave = new User
        {
            UserName = _user.UserName,
            Email = _user.Email,
            PasswordHash = HashPassword(_password),
            RolID = 6, // CLIENTE
            Active = true,
            RegistrationDate = DateTime.Now
        };

        await UserRepository.AddAsync(userToSave);
        await UserRepository.SaveChangesAsync();

        Navigation.NavigateTo("/login");
    }

    private string HashPassword(string password)
    {
        using var sha256 = SHA256.Create();
        var bytes = Encoding.UTF8.GetBytes(password);
        var hash = sha256.ComputeHash(bytes);
        return Convert.ToBase64String(hash);
    }
}