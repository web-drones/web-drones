@page "/"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using MudBlazor
@using Web_Drones_Proyect.Models
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization


<!-- ===================== -->
<!-- Carrusel principal -->
<!-- ===================== -->
<div style="width:100%; margin:0; padding:0;">
    <MudCarousel Class="mud-width-full"
                 Style="height:450px; margin:0; padding:0;"
                 ShowArrows="true"
                 ShowBullets="true"
                 EnableSwipeGesture="true"
                 AutoCycle="true"
                 TData="object">

        <!-- Slide 1 -->
        <MudCarouselItem Transition="Transition.Slide" Color="Color.Primary">
            <div class="d-flex" style="height:100%">
                <MudIcon Class="mx-auto my-auto" Icon="@Icons.Custom.Brands.MudBlazor" Size="Size.Large" />
            </div>
        </MudCarouselItem>

        <!-- Slide 2 -->
        <MudCarouselItem Transition="Transition.Slide" Color="Color.Secondary">
            <div class="d-flex" style="height:100%">
                <MudIcon Class="mx-auto my-auto" Icon="@Icons.Custom.Brands.MudBlazor" Size="Size.Large" />
            </div>
        </MudCarouselItem>

        <!-- Slide 3 -->
        <MudCarouselItem Transition="Transition.Slide">
            <div class="d-flex" style="height:100%">
                <MudIcon Class="mx-auto my-auto" Icon="@Icons.Custom.Brands.MudBlazor" Color="Color.Primary" Size="Size.Large" />
            </div>
        </MudCarouselItem>

    </MudCarousel>
</div>

<!-- ===================== -->
<!-- Lista de drones -->
<!-- ===================== -->
<MudContainer Class="mt-10 d-flex flex-column align-items-center">

    <!-- Itera todos los drones obtenidos desde la base de datos -->
    @for (int i = 0; i < _drones.Count; i++)
    {
        var drone = _drones[i];

        // Alterna la posición de la imagen (izquierda / derecha)
        bool imageLeft = i % 2 == 0;

        <MudPaper Class="drone-card mb-4" Elevation="2">

            <div class="drone-row-card">

                <!-- Imagen a la izquierda -->
                @if (imageLeft)
                {
                    <MudImage Src="@(drone.Images.FirstOrDefault()?.UrlImageDron ?? "/images/no-image.png")"
                              Alt="@drone.Name"
                              Class="drone-image" />
                }

                <!-- Información del dron -->
                <div class="drone-info @(imageLeft ? "drone-info-right" : "drone-info-left")">

                    <div class="drone-info-content">

                        <!-- Nombre -->
                        <MudText Typo="Typo.h5" Class="mb-3">@drone.Name</MudText>

                        <!-- Descripción -->
                        <MudText Typo="Typo.body2" Class="mb-3">@drone.Description</MudText>

                        <!-- Precio -->
                        <MudText Typo="Typo.subtitle2" Class="mb-3">
                            Precio Venta: @drone.PriceSale
                        </MudText>

                        <!-- Botones de acciones -->
                        <div class="button-row">

                            <AuthorizeView Roles="ADMIN,CLIENTE">
                                <MudButton Class="drone-btn btn-add"
                                           StartIcon="@Icons.Material.Filled.AddShoppingCart"
                                           OnClick="@(() => AddToCartAsync(drone))">
                                    Añadir
                                </MudButton>
                            </AuthorizeView>

                            <MudButton Class="drone-btn btn-view"
                                       StartIcon="@Icons.Material.Filled.Visibility"
                                       OnClick="@(() => Nav.NavigateTo($"/drones/details/{drone.DronID}"))">
                                Ver
                            </MudButton>

                            <AuthorizeView Roles="ADMIN">
                                <Authorized>

                                    <MudButton Class="drone-btn btn-edit"
                                               StartIcon="@Icons.Material.Filled.Edit"
                                               OnClick="@(() => EditDroneAsync(drone))">
                                        Editar
                                    </MudButton>

                                    <MudButton Class="drone-btn btn-delete"
                                               StartIcon="@Icons.Material.Filled.Delete"
                                               OnClick="@(() => DeleteDroneAsync(drone.DronID))">
                                        Borrar
                                    </MudButton>

                                </Authorized>
                            </AuthorizeView>

                        </div>

                    </div>

                </div>

                <!-- Imagen a la derecha -->
                @if (!imageLeft)
                {
                    <MudImage Src="@(drone.Images.FirstOrDefault()?.UrlImageDron ?? "/images/no-image.png")"
                              Alt="@drone.Name"
                              Class="drone-image" />
                }

            </div>

        </MudPaper>
    }

</MudContainer>
