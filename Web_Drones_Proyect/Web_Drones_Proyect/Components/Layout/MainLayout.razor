@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization
@using MudBlazor

<!-- Layout principal de la aplicación -->
<MudLayout Style="min-height:100vh; display:flex; flex-direction:column;">

    <!-- Barra superior de navegación -->
    <MudAppBar Style="background-color:#004D40;" Elevation="4" Fixed="true">
        <MudIconButton Icon="@Icons.Custom.Brands.GitHub" Style="color:#4DB6AC;" />
        <MudText Typo="Typo.h6" Class="ml-2" Style="color:#4DB6AC;">Web Drones</MudText>
        <MudSpacer />

        <!-- Menú desplegable de servicios disponibles -->
        <MudMenu Label="Servicios" Variant="Variant.Text" Class="mx-2 servicios-menu"
                 PopoverClass="servicios-menu-popover"
                 Style="color:#4DB6AC; font-weight:500; font-size:0.9rem;">
            <MudMenuItem Style="display:block; width:100%; height:100%; background-color:#004D40; color:#4DB6AC; border:none;"
                         Href="/venta">Venta</MudMenuItem>
            <MudMenuItem Style="display:block; width:100%; height:100%; background-color:#004D40; color:#4DB6AC; border:none;"
                         Href="/renta">Renta</MudMenuItem>
        </MudMenu>

        <!-- Botón visible solo para usuarios con rol ADMIN -->
        <AuthorizeView Roles="ADMIN">
            <MudButton OnClick="OpenAddDialog" Variant="Variant.Text" Size="Size.Small" Style="color:#4DB6AC;"
                       Class="mx-2">
                Agregar un Dron
            </MudButton>
        </AuthorizeView>

        <!-- Opciones según estado de autenticación -->
        <AuthorizeView>
            <Authorized>
                <!-- Cierra la sesión del usuario autenticado -->
                <MudButton Variant="Variant.Text" Size="Size.Small" Style="color:#4DB6AC;" OnClick="LogoutAsync">
                    Cerrar sesión
                </MudButton>
            </Authorized>
            <NotAuthorized>
                <!-- Navegación a páginas de autenticación -->
                <MudButton Variant="Variant.Text" Size="Size.Small" Style="color:#4DB6AC;" Href="/login">
                    Login
                </MudButton>

                <MudButton Variant="Variant.Outlined" Size="Size.Small" Style="color:#4DB6AC; border-color:#4DB6AC;" Href="/register" Class="mx-2">
                    Registrarse
                </MudButton>
            </NotAuthorized>
        </AuthorizeView>

        <!-- Icono del carrito visible para usuarios que no sean Visitante -->
        <AuthorizeView>
            <Authorized Context="auth">
                @if (!auth.User.IsInRole("Visitante"))
                {
                    <MudIconButton Icon="@Icons.Material.Filled.ShoppingCart" Style="color:#4DB6AC;" Class="mx-2" Href="/carrito" />
                }
            </Authorized>
        </AuthorizeView>

    </MudAppBar>

    <!-- Contenedor donde se renderizan las páginas -->
    <MudMainContent Class="main-content-reset">
        @Body
    </MudMainContent>

    <!-- Pie de página del sitio -->
    <MudPaper Elevation="2" Class="pa-4" Style="background-color:#004D40;">
        <MudContainer MaxWidth="MaxWidth.Large" Style="display:flex; justify-content:space-between; align-items:center;">
            <MudText Style="color:#4DB6AC;">© @DateTime.Now.Year Web Drones</MudText>
            <MudText Style="color:#4DB6AC;">Drones</MudText>
            <MudButton Variant="Variant.Text" Size="Size.Small" Style="color:#4DB6AC;" Class="mx-2" Href="/About">
                Quienes somos
            </MudButton>
        </MudContainer>
    </MudPaper>

</MudLayout>

<!-- Proveedores globales de MudBlazor -->
<MudThemeProvider />
<MudDialogProvider />
<MudSnackbarProvider />
<MudPopoverProvider />

<style>
    /* Estilos personalizados para el menú desplegable */
    .mud-popover .mud-list {
        background-color: #004D40 !important;
    }

    .servicios-menu .mud-button-root {
        color: #4DB6AC !important;
        font-weight: 500;
    }

    .servicios-menu .mud-icon-button {
        color: #4DB6AC !important;
    }
</style>