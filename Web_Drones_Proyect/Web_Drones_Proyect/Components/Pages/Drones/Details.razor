@page "/drones/details/{Id:int}"
@using MudBlazor
@using Web_Drones_Proyect.Models

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-8 mb-10">
@if (_drone == null)
{
    <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Large" Class="mx-auto d-block mt-10" />
}
else
{
    <MudPaper Class="details-card pa-6" Elevation="6">

        <MudGrid>

            <!-- GALERÍA -->
            <MudItem xs="12" md="6">

                    <div class="image-wrapper">

                        <MudImage Src="@(_selectedImage ?? "/images/no-image.png")"
                                  Alt="@_drone.Name"
                                  Class="main-image" />

                        <div class="image-description mt-4">
                            <MudText Class="description-text">
                                @_drone.Description
                            </MudText>
                        </div>

                    </div>

            </MudItem>

            <!-- INFO -->
            <MudItem xs="12" md="6">

                <div class="info-section">

                    <MudText Typo="Typo.h4" Class="drone-title mb-2">
                        @_drone.Name
                    </MudText>

                        <MudChip T="string" Color="Color.Success" Variant="Variant.Filled" Class="mb-4 state-chip">
                            @_drone.State
                        </MudChip>

                    <MudDivider Class="mb-4" />

                    <MudGrid Class="spec-grid">

                        <MudItem xs="6">
                            <div class="spec-box">
                                <MudText Typo="Typo.subtitle2">Autonomía</MudText>
                                <MudText Typo="Typo.h6">@_drone.Autonomy min</MudText>
                            </div>
                        </MudItem>

                        <MudItem xs="6">
                            <div class="spec-box">
                                <MudText Typo="Typo.subtitle2">Alcance</MudText>
                                <MudText Typo="Typo.h6">@_drone.Scope km</MudText>
                            </div>
                        </MudItem>

                        <MudItem xs="6">
                            <div class="spec-box">
                                <MudText Typo="Typo.subtitle2">Cámara</MudText>
                                <MudText Typo="Typo.h6">@_drone.Camera</MudText>
                            </div>
                        </MudItem>

                        <MudItem xs="6">
                            <div class="spec-box">
                                <MudText Typo="Typo.subtitle2">Stock</MudText>
                                <MudText Typo="Typo.h6">@_drone.Stock</MudText>
                            </div>
                        </MudItem>

                    </MudGrid>

                    <MudDivider Class="my-6" />

                    <div class="price-section">

                        @if (_drone.PriceSale.HasValue)
                        {
                            <MudText Typo="Typo.h5" Class="price-sale">
                                Venta: $@_drone.PriceSale
                            </MudText>
                        }

                        @if (_drone.PriceRent.HasValue)
                        {
                            <MudText Typo="Typo.h6" Class="price-rent">
                                Renta: $@_drone.PriceRent / día
                            </MudText>
                        }

                    </div>

                    <MudButton Variant="Variant.Filled"
                               Class="add-cart-btn mt-6"
                               StartIcon="@Icons.Material.Filled.ShoppingCart">
                        Añadir al carrito
                    </MudButton>

                </div>

            </MudItem>

        </MudGrid>

    </MudPaper>
}
</MudContainer> 

<style>
    .details-card {
        border-radius: 20px;
        background: linear-gradient(145deg, #ffffff, #f4f4f4);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .details-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 20px 40px rgba(0,0,0,0.15);
        }

    .image-wrapper {
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    .main-image {
        width: 100%;
        height: 420px;
        object-fit: cover;
        border-radius: 16px;
        transition: transform 0.4s ease;
    }

        .main-image:hover {
            transform: scale(1.03);
        }

    .thumbnail-row {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
    }

    .thumbnail {
        width: 80px;
        height: 80px;
        object-fit: cover;
        border-radius: 12px;
        cursor: pointer;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .thumbnail:hover {
            transform: scale(1.08);
            box-shadow: 0 6px 15px rgba(0,0,0,0.2);
        }

    .active-thumb {
        border: 3px solid #4DB6AC;
    }

    .drone-title {
        font-weight: 700;
        letter-spacing: 1px;
    }

    .description-text {
        font-size: 1.05rem;
        line-height: 1.7;
        color: #555;
    }

    .spec-box {
        background-color: #ffffff;
        padding: 16px;
        border-radius: 14px;
        box-shadow: 0 6px 15px rgba(0,0,0,0.08);
        transition: transform 0.2s ease;
    }

        .spec-box:hover {
            transform: translateY(-3px);
        }

    .price-sale {
        color: #004D40;
        font-weight: 700;
    }

    .price-rent {
        color: #4DB6AC;
    }

    .add-cart-btn {
        width: 100%;
        height: 55px;
        font-size: 1rem;
        font-weight: 600;
        background: linear-gradient(90deg, #004D40, #4DB6AC);
        color: white;
        border-radius: 14px;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .add-cart-btn:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 20px rgba(0,0,0,0.25);
    }


    @@media (max-width: 768px) {
        .main-image

    {
        height: 280px;
    }

    .details-card {
        padding: 20px;
    }

    }
</style>