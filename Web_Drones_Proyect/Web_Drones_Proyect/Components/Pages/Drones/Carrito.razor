@page "/carrito"
@using MudBlazor
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<div class="cart-wrap">

    <div class="cart-summary">
        <div>
            <h2>🛒 Mi carrito</h2>
            <div class="summary-meta">
                @* Muestra la cantidad total de ítems distintos en el carrito *@
                <span>Total productos: @TotalProductos</span>
                @* Muestra cuántos productos ha marcado el usuario con el checkbox *@
                <span>Seleccionados: @ProductosSeleccionados</span>
            </div>
        </div>

        <div class="summary-actions">
            <div class="summary-total">
                @* Cálculo monetario total de los elementos seleccionados *@
                Total: @TotalSeleccionado.ToString("C")
            </div>

            @* Botón para procesar el pago únicamente de los artículos marcados *@
            <MudButton Class="btn-pay btn-pay--selected"
                       OnClick="PagarSeleccionados">
                Pagar seleccionados
            </MudButton>

            @* Botón para procesar el pago de todos los artículos presentes en el carrito *@
            <MudButton Class="btn-pay btn-pay--all"
                       OnClick="PagarTodo">
                Pagar todo
            </MudButton>
        </div>
    </div>

    @* LÓGICA DE CARGA: Si la lista de ítems es nula, muestra un indicador de carga *@
    @if (_items == null)
    {
        <MudProgressCircular Indeterminate />
    }
    @* Si la lista está vacía, muestra un mensaje informativo *@
    else if (!_items.Any())
    {
        <MudAlert Severity="Severity.Info">
            El carrito está vacío
        </MudAlert>
    }
    else
    {
        <div class="cart-grid">
            @* Itera sobre cada objeto en la colección de ítems del carrito *@
            @foreach (var item in _items)
            {
                <div class="cart-card">
                    @* Checkbox para incluir/excluir el producto del cálculo total de pago *@
                    <MudCheckBox T="bool" @bind-Value="item.Selected" Class="select-box" />

                    @* Imagen del dron: utiliza la primera disponible o una imagen por defecto *@
                    <img src="@(item.Drone.Images.FirstOrDefault()?.UrlImageDron ?? "/images/no-image.png")"
                         alt="@item.Drone.Name" />

                    <h3>@item.Drone.Name</h3>

                    <p class="desc">@item.Drone.Description</p>

                    @* Especificaciones técnicas del dron y tipo de precio aplicado *@
                    <div class="specs">
                        <span>📷 @item.Drone.Camera</span>
                        <span>💼 @item.PriceType</span>
                    </div>

                    <div class="price">
                        @item.UnitPrice.ToString("C")
                    </div>

                    @* Control para modificar la cantidad y visualización del subtotal por producto *@
                    <div class="qty-row">
                        <MudNumericField @bind-Value="item.Quantity"
                                         Min="1"
                                         Immediate="true"
                                         Variant="Variant.Outlined" />
                        <span>@item.SubTotal.ToString("C")</span>
                    </div>

                    @* Botón para eliminar el artículo específico del carrito mediante su ID *@
                    <MudButton Class="btn-remove"
                               OnClick="@(() => Remove(item.CartItemID))">
                        Quitar
                    </MudButton>
                </div>
            }
        </div>
    }
</div>


<style>

    :root {
        --teal-1: #E0F2F1;
        --teal-2: #B2DFDB;
        --teal-3: #26A69A;
        --teal-4: #00796B;
        --teal-5: #004D40;
    }

    .cart-wrap {
        padding: 1.5rem;
        min-height: 100vh;
        background: linear-gradient(180deg, var(--teal-1), var(--teal-2));
    }

    /* ===== RESUMEN STICKY ===== */
    .cart-summary {
        position: sticky;
        top: 0;
        z-index: 20;
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1.2rem 1.5rem;
        margin-bottom: 1.5rem;
        border-radius: 18px;
        background: linear-gradient(135deg, var(--teal-5), var(--teal-4));
        color: white;
        box-shadow: 0 10px 30px rgba(0,0,0,.25);
        animation: fadeUp .6s ease;
    }

    .summary-meta {
        font-size: .9rem;
        opacity: .9;
    }

    .summary-actions {
        display: flex;
        align-items: center;
        gap: .75rem;
    }

    .summary-total {
        font-size: 1.3rem;
        font-weight: 900;
        margin-right: .5rem;
    }

    /* ===== GRID ===== */
    .cart-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1.2rem;
    }

    /* ===== CARD ===== */
    .cart-card {
        background: rgba(255,255,255,.75);
        border-radius: 20px;
        padding: 1.2rem;
        box-shadow: 0 8px 25px rgba(0,0,0,.15);
        transition: all .3s ease;
        animation: fadeUp .7s ease;
    }

        .cart-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 15px 35px rgba(0,0,0,.3);
        }

        .cart-card img {
            width: 100%;
            height: 170px;
            object-fit: cover;
            border-radius: 14px;
            margin-bottom: .6rem;
        }

        .cart-card h3 {
            margin: .3rem 0;
        }

    .desc {
        font-size: .85rem;
        opacity: .75;
    }

    .specs {
        display: flex;
        gap: .5rem;
        font-size: .8rem;
        margin: .4rem 0;
    }

    .price {
        font-size: 1.1rem;
        font-weight: 900;
        color: var(--teal-4);
    }

    .qty-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin: .6rem 0;
    }

    .select-box {
        position: absolute;
    }

    /* ===== BOTONES PREMIUM ===== */

    .btn-pay {
        border-radius: 999px;
        padding: .55rem 1.2rem;
        font-weight: 900;
        letter-spacing: .3px;
        color: #E0F2F1;
        border: none;
        transition: all .25s ease;
        box-shadow: 0 6px 18px rgba(0,0,0,.25);
        position: relative;
        overflow: hidden;
    }

        .btn-pay::after {
            content: "";
            position: absolute;
            inset: 0;
            background: radial-gradient(circle at 30% 30%, rgba(255,255,255,.25), transparent 60%);
            opacity: 0;
            transition: opacity .3s ease;
        }

        .btn-pay:hover::after {
            opacity: 1;
        }

        .btn-pay:hover {
            transform: translateY(-3px) scale(1.03);
            box-shadow: 0 12px 30px rgba(0,0,0,.35), 0 0 20px rgba(29,233,182,.35);
        }

    /* Pagar seleccionados */
    .btn-pay--selected {
        background: linear-gradient(135deg, #009688, #00796B);
    }

    /* Pagar todo */
    .btn-pay--all {
        background: linear-gradient(135deg, #2ECC71, #1E8449);
    }

    /* ===== BOTÓN QUITAR ===== */

    .btn-remove {
        margin-top: .3rem;
        align-self: flex-start;
        font-weight: 800;
        color: #B71C1C;
        background: transparent;
        border-radius: 999px;
        padding: .35rem .8rem;
        transition: all .25s ease;
    }

        .btn-remove:hover {
            background: rgba(183,28,28,.12);
            transform: translateX(4px);
        }

    /* ===== RESPONSIVE ===== */
    @@media (max-width: 1100px) {
        .cart-grid

    {
        grid-template-columns: repeat(2, 1fr);
    }

    }

    @@media (max-width: 700px) {
        .cart-grid

    {
        grid-template-columns: 1fr;
    }

    .cart-summary {
        flex-direction: column;
        gap: .8rem;
        text-align: center;
    }

    }

    /* ===== ANIMACIONES ===== */
    @@keyframes fadeUp {
        from

    {
        opacity: 0;
        transform: translateY(25px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }
</style>