@using MudBlazor
@using Web_Drones_Proyect.Models
@inject NavigationManager Nav
<MudDialog>

    <DialogContent>

        <MudText Typo="Typo.h5" Class="mb-2">
            🧾 Confirmar pedido
        </MudText>

        <MudDivider Class="mb-3" />

        @foreach (var item in Items)
        {
            <MudPaper Elevation="1" Class="pa-3 mb-3">
                <MudText Typo="Typo.subtitle1" Class="fw-bold">
                    🛸 @item.Drone.Name
                </MudText>

                <MudGrid Class="mt-1">
                    <MudItem xs="4">
                        <MudText Typo="Typo.body2">
                            Cantidad:
                        </MudText>
                        <MudText Typo="Typo.body1">
                            @item.Quantity
                        </MudText>
                    </MudItem>

                    <MudItem xs="4">
                        <MudText Typo="Typo.body2">
                            Precio:
                        </MudText>
                        <MudText Typo="Typo.body1">
                            @item.UnitPrice.ToString("C")
                        </MudText>
                    </MudItem>

                    <MudItem xs="4">
                        <MudText Typo="Typo.body2">
                            Subtotal:
                        </MudText>
                        <MudText Typo="Typo.body1" Color="Color.Primary">
                            @item.SubTotal.ToString("C")
                        </MudText>
                    </MudItem>
                </MudGrid>
            </MudPaper>
        }

        <MudDivider Class="my-3" />

        <MudText Typo="Typo.h6" Align="Align.Right">
            💰 Total: <b>@Total.ToString("C")</b>
        </MudText>

    </DialogContent>

    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancel">
            Cancelar
        </MudButton>

        <MudButton Color="Color.Success" Variant="Variant.Filled" OnClick="SendWhatsApp">
            Enviar por WhatsApp
        </MudButton>
    </DialogActions>

</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public List<CartItem> Items { get; set; } = new();
    [Parameter] public decimal Total { get; set; }

    private void Cancel() => MudDialog.Cancel();

    private void SendWhatsApp()
    {
        var sb = new System.Text.StringBuilder();

        sb.AppendLine("🧾 *Pedido Web Drones*");
        sb.AppendLine("──────────────────");

        foreach (var i in Items)
        {
            sb.AppendLine(
                $"🛸 {i.Drone.Name}\n" +
                $"   • Cantidad: {i.Quantity}\n" +
                $"   • Precio: {i.UnitPrice:C}\n" +
                $"   • Subtotal: {i.SubTotal:C}\n"
            );
        }

        sb.AppendLine("──────────────────");
        sb.AppendLine($"💰 *TOTAL A PAGAR:* {Total:C}");
        sb.AppendLine("\nQuedo atento para confirmar el pedido ✅");

        var message = Uri.EscapeDataString(sb.ToString());

        var phone = "18496517787"; // WhatsApp RD
        var url = $"https://wa.me/{phone}?text={message}";

        Nav.NavigateTo(url, true);
        MudDialog.Close(DialogResult.Ok(true));
    }
}