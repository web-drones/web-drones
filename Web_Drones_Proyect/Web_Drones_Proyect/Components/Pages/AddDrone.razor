@using MudBlazor
@using Web_Drones_Proyect.Data.Repositories
@using Web_Drones_Proyect.Models
@using Microsoft.AspNetCore.Components.Forms


<MudDialog Class="bg-dark-dialog">

    <DialogContent>
        <MudForm @ref="_form">

            <MudGrid>

                <!-- COLUMNA IZQUIERDA -->
                <MudItem xs="12" md="5">

                    <MudTextField @bind-Value="_drone.Name"
                                  Label="Nombre"
                                  Required="true"
                                  Class="white-text" />

                    <MudSelect T="int" Label="Categoría"
                               @bind-Value="_drone.CategoryID"
                               Required="true"
                               Class="white-text">
                        @foreach (var cat in _categories)
                        {
                            <MudSelectItem Value="@cat.CategoryID">@cat.Name</MudSelectItem>
                        }
                    </MudSelect>

                    <MudSelect T="int" Label="Tipo de Dron"
                               @bind-Value="_drone.TypeDroneID"
                               Required="true"
                               Class="white-text">
                        @foreach (var type in _types)
                        {
                            <MudSelectItem Value="@type.TypeDroneID">@type.Name</MudSelectItem>
                        }
                    </MudSelect>

                    <MudNumericField @bind-Value="_drone.PriceSale"
                                     Label="Precio Venta"
                                     T="decimal?"
                                     Class="white-text" />

                    <MudNumericField @bind-Value="_drone.PriceRent"
                                     Label="Precio Renta"
                                     T="decimal?"
                                     Class="white-text" />

                    <MudTextField @bind-Value="_drone.State"
                                  Label="Estado"
                                  Required="true"
                                  Class="white-text" />

                    <MudNumericField @bind-Value="_drone.Stock"
                                     Label="Stock"
                                     T="int"
                                     Required="true"
                                     Class="white-text" />

                    <MudNumericField @bind-Value="_drone.Autonomy"
                                     Label="Autonomía"
                                     T="int"
                                     Class="white-text" />

                    <MudNumericField @bind-Value="_drone.Scope"
                                     Label="Alcance"
                                     T="int"
                                     Class="white-text" />

                    <MudTextField @bind-Value="_drone.Camera"
                                  Label="Cámara"
                                  Class="white-text" />

                    <MudTextField @bind-Value="_drone.Description"
                                  Label="Descripción"
                                  Lines="3"
                                  Class="white-text" />

                </MudItem>

                <!-- COLUMNA DERECHA -->
                <MudItem xs="12" md="7">

                    <MudPaper Class="pa-4 image-box" Elevation="3">

                        <MudText Typo="Typo.h6" Class="mb-3 text-center white-title">
                            Imagen del Dron
                        </MudText>

                        <InputFile OnChange="UploadImage" class="mb-3" />

                        @if (!string.IsNullOrEmpty(_imagePath))
                        {
                            <MudImage Src="@_imagePath"
                                      Alt="Preview"
                                      Class="preview-img mt-2" />
                        }

                    </MudPaper>

                </MudItem>

            </MudGrid>

        </MudForm>
    </DialogContent>

    <DialogActions>
        <div class="actions-container">
            <MudButton OnClick="Cancel"
                       Variant="Variant.Outlined"
                       Style="color:#ff0060; border-color:#ff0060;">
                Cancelar
            </MudButton>

            <MudButton OnClick="Save"
                       Variant="Variant.Filled"
                       Style="background-color:#26A69A; color: black;">
                Guardar
            </MudButton>
        </div>
    </DialogActions>

</MudDialog>

<style>
    .bg-dark-dialog {
        background-color: #121212 !important;
        color: white !important;
    }

    /* Inputs, labels y textos normales */
    .white-text input,
    .white-text textarea,
    .white-text label {
        color: white !important;
    }

    /* Texto seleccionado dentro del MudSelect */
    .white-text .mud-input-slot {
        color: white !important;
    }

    /* ========================= */
    /* DROPDOWN PERSONALIZADO */
    /* ========================= */

    /* Fondo del dropdown */
    .mud-popover .mud-list {
        background-color: #1e1e1e !important;
    }

    /* Opciones del dropdown */
    .mud-popover .mud-list-item {
        color: #4DB6AC !important;
        transition: background-color 0.2s ease;
    }

        /* Opción seleccionada */
        .mud-popover .mud-list-item.mud-selected-item {
            color: #4DB6AC !important;
        }

        /* Hover */
        .mud-popover .mud-list-item:hover {
            background-color: #004D40 !important;
            color: #4DB6AC !important;
        }

    /* ========================= */
    /* IMAGEN */
    /* ========================= */

    .white-title {
        color: white;
        font-weight: 600;
    }

    .image-box {
        background-color: #1e1e1e;
        border-radius: 12px;
        text-align: center;
    }

    .preview-img {
        width: 100%;
        max-height: 250px;
        object-fit: contain;
        border-radius: 10px;
    }

    /* ========================= */
    /* BOTONES */
    /* ========================= */

    .actions-container {
        width: 100%;
        display: flex;
        justify-content: center;
        gap: 20px;
        padding: 16px 0;
    }

    /* X blanca del dialog */
    .mud-dialog-titlebar-close {
        color: white !important;
    }
    }</style>